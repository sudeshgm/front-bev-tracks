+    net = float(np.hypot(xw[-1] - xw[0], zw[-1] - zw[0]) / T) if T > 0 else 0.0
+    df = np.diff(frames) / fps
+    v = np.hypot(np.diff(xw), np.diff(zw)) / np.maximum(df, 1e-6)
+    return float(np.median(v)), net
