+            sup = np.mean([any(np.hypot(xx - p[0], zz - p[1]) <= persons_near_m for p in pmap.get(f, []))
+                           for f, xx, zz in zip(t["frames"], t["x"], t["z"])])
+            if sup < rider_frac:
